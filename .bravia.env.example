# ==============================================================================
# Sony Bravia Local Target Configuration (.bravia.env)
# ==============================================================================
# Run './bravia-opt.sh init' to auto-discover your TV and generate '.bravia.env',
# or copy this file to '.bravia.env' and fill in your TV's values manually.
# ==============================================================================

# Friendly name advertised via mDNS (_androidtvremote2._tcp / _googlecast._tcp)
TV_NAME="BRAVIA"

# mDNS A-record hostname (typically 'Android.local.' on Android TV)
TV_MDNS_HOST="Android.local."

# TV's network interface MAC address (used as DHCP fallback via 'arp -a')
TV_MAC=""

# Last known IPv4 address (used if mDNS and ARP cache are both cold)
TV_FALLBACK_IP=""

# ADB TCP port (default: 5555 for classic Network Debugging)
ADB_PORT="5555"

# UI & Runtime Tuning Preferences
# - ANIMATION_SCALE:
#     0.0 = Instant transitions & static focus highlight (terminates ValueAnimator breathing pulse on frame 1)
#     0.6 = Snappy transitions while preserving a gentle focus breathing animation
#     1.0 = Stock Android TV animation timing
ANIMATION_SCALE="0.0"

# - LONG_PRESS_TIMEOUT: Delay in ms before holding a D-pad direction starts continuous fast-scrolling (stock: 400)
LONG_PRESS_TIMEOUT="250"

# - MAX_CACHED_PROCESSES: Cap on background cached apps to prevent ZRAM swap thrashing on 2GB RAM models
MAX_CACHED_PROCESSES="2"
